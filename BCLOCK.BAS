 drawhand VAL(RIGHT$(TIME$, 2)), -7, 37, 1
 drawhand VAL(RIGHT$(TIME$, 5)), 0, 36, 2
 drawhand 5 * (VAL(TIME$) MOD 12), 0, 18, 4

 PCOPY 0, 1

LOOP UNTIL LEN(INKEY$)

